<Project>
  <!--
    dotnet publish -p:PublishProfile=win-x64   (from discloak/) -> ..\publish\discloak.exe: one file that needs
    nothing installed (the .NET runtime is inside, compressed: about 37 MB). Every disc gets a copy (DiscProgram).
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- libsodium (NSec) goes inside the exe too; .NET unpacks it to %TEMP%\.net\discloak\ on first use -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
