<Project>
  <!-- dotnet publish -p:PublishProfile=win-x64   (from bdxl/) -> ..\publish\bdxl.exe: one file, needs the .NET 10 runtime -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- libsodium (NSec) goes inside the exe too; .NET unpacks it to %TEMP%\.net\bdxl\ on first use -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
