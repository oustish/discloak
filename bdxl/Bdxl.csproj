<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>bdxl</AssemblyName>
    <RootNamespace>Bdxl</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- major.minor.patch, raised by hand in the commit that makes the change: see CONTRIBUTING.md -->
    <Version>0.7.1</Version>
    <Authors>oustish</Authors>
    <Copyright>Copyright 2026 oustish (https://github.com/oustish)</Copyright>
    <!-- BdxlBuildInfo below appends the short commit, uncommitted changes and the build time instead of the full commit -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    What the exe was built from, for 'bdxl version' and the "createdBy" each staged disc records:
    InformationalVersion = 0.6.0+<commit>[-dirty].<yyyyMMddTHHmmZ> (semver build metadata), plus the branch, the
    commit, whether there were uncommitted changes and the build time (UTC) as assembly metadata. Without git
    (a source copy) it is 0.6.0+<yyyyMMddTHHmmZ> and the commit is unknown.
  -->
  <Target Name="BdxlBuildInfo" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="BdxlCommit" />
      <Output TaskParameter="ExitCode" PropertyName="BdxlGitExit" />
    </Exec>
    <Exec Command="git branch --show-current" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="'$(BdxlGitExit)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="BdxlBranch" />
    </Exec>
    <Exec Command="git status --porcelain" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="'$(BdxlGitExit)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="BdxlChanges" />
    </Exec>
    <PropertyGroup>
      <BdxlCommit Condition="'$(BdxlGitExit)' != '0'"></BdxlCommit>
      <BdxlDirty>false</BdxlDirty>
      <BdxlDirty Condition="'$(BdxlCommit)' != '' and '$(BdxlChanges)' != ''">true</BdxlDirty>
      <BdxlDirtyTag Condition="'$(BdxlDirty)' == 'true'">-dirty</BdxlDirtyTag>
      <BdxlNow>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmm"))</BdxlNow>
      <BdxlBuildStamp>$(BdxlNow.Substring(0, 8))T$(BdxlNow.Substring(8, 4))Z</BdxlBuildStamp>
      <BdxlBuiltUtc>$(BdxlNow.Substring(0, 4))-$(BdxlNow.Substring(4, 2))-$(BdxlNow.Substring(6, 2))T$(BdxlNow.Substring(8, 2)):$(BdxlNow.Substring(10, 2)):00Z</BdxlBuiltUtc>
      <InformationalVersion Condition="'$(BdxlCommit)' != ''">$(Version)+$(BdxlCommit)$(BdxlDirtyTag).$(BdxlBuildStamp)</InformationalVersion>
      <InformationalVersion Condition="'$(BdxlCommit)' == ''">$(Version)+$(BdxlBuildStamp)</InformationalVersion>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="GitCommit" Value="$(BdxlCommit)" />
      <AssemblyMetadata Include="GitBranch" Value="$(BdxlBranch)" />
      <AssemblyMetadata Include="GitDirty" Value="$(BdxlDirty)" />
      <AssemblyMetadata Include="BuiltUtc" Value="$(BdxlBuiltUtc)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Using Include="System.Globalization" />
    <Using Include="System.Security.Cryptography" />
    <Using Include="System.Text" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Text.Json.Serialization" />
    <Using Include="System.Text.RegularExpressions" />
  </ItemGroup>

  <!-- the license and the third-party notices go with every copy of the program: next to bdxl.exe when published -->
  <ItemGroup>
    <None Include="..\LICENSE.md;..\LICENSING.md;..\THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.14" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

</Project>
