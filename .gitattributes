# Text files are stored with LF and checked out with LF, on every platform (.NET, git and every editor in use handle
# LF on Windows); Windows scripts keep CRLF.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# never treated as text
*.exe binary
*.dll binary
*.zip binary
*.png binary
*.ico binary

# The fixtures are files exactly as an older version wrote them: never convert their line endings
tests/*/Fixtures/** -text
